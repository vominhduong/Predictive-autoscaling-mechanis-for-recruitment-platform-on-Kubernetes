# PostgreSQL
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=recruitment
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=recruitment
RABBITMQ_DEFAULT_PASS=recruitment
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ROOT_USER=recruitment
MINIO_ROOT_PASSWORD=recruitment
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Auth Service JWT (development example)
JWT_ISSUER=recruitment-auth-service
JWT_ACCESS_TOKEN_EXPIRATION=1800s
JWT_PRIVATE_KEY=classpath:keys/dev-private.pem
JWT_PUBLIC_KEY=classpath:keys/dev-public.pem
REFRESH_TOKEN_EXPIRATION=604800s

# API Gateway upstreams and local CORS
AUTH_SERVICE_URI=http://localhost:8081
USER_SERVICE_URI=http://localhost:8082
JOB_SERVICE_URI=http://localhost:8083
APPLICATION_SERVICE_URI=http://localhost:8084
CORS_ALLOWED_ORIGINS=http://localhost:5173

# User Service and private CV storage
USER_DB_URL=jdbc:postgresql://localhost:5432/user_db
MINIO_ENDPOINT=http://localhost:9000
MINIO_CV_BUCKET=recruitment-cvs
CV_MAX_SIZE_BYTES=5242880
# Set a high-entropy value locally; callers of /internal/** must send it as X-Internal-Token.
INTERNAL_API_TOKEN=
